<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="io.github.anastaci1a.localica.debug" />
    </queries>
    <application>
        <activity android:name="io.github.anastaci1a.localica.TestDocumentsProvider$LyricsGrantActivity"
            android:exported="true" android:theme="@android:style/Theme.NoDisplay" />
        <provider android:name="io.github.anastaci1a.localica.TestDocumentsProvider"
            android:authorities="io.github.anastaci1a.localica.test.documents"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <provider android:name="io.github.anastaci1a.localica.QueueScaleDocumentsProvider"
            android:authorities="io.github.anastaci1a.localica.test.queue.scale"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <activity android:name="io.github.anastaci1a.localica.QueueScaleGrantActivity"
            android:exported="true" android:theme="@android:style/Theme.NoDisplay" />
        <provider android:name="io.github.anastaci1a.localica.IncompleteScanDocumentsProvider"
            android:authorities="io.github.anastaci1a.localica.test.incomplete.scan"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <activity android:name="io.github.anastaci1a.localica.IncompleteScanGrantActivity"
            android:exported="true" android:theme="@android:style/Theme.NoDisplay" />
        <provider android:name="io.github.anastaci1a.localica.ArtworkGrantProvider"
            android:authorities="io.github.anastaci1a.localica.test.artwork.grants"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />
        <activity android:name="io.github.anastaci1a.localica.ArtworkGrantActivity"
            android:exported="true" android:theme="@android:style/Theme.NoDisplay" />
        <service
            android:name="io.github.anastaci1a.localica.FloatingTestImeService"
            android:label="@string/localica_floating_test_ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true"
            android:process=":floating_ime_fixture">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/localica_floating_test_ime" />
        </service>
        <provider android:name="io.github.anastaci1a.localica.NavigationRandomCorpusDocumentsProvider"
            android:authorities="io.github.anastaci1a.localica.test.navigation.random"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:process=":navigation_random">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <activity android:name="io.github.anastaci1a.localica.NavigationRandomCorpusGrantActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:noHistory="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:process=":navigation_random" />
    </application>
</manifest>
